class OrmError < Exception:
  attr message

  def init(@message)
  def to_str():
    @message

class SchemaError < OrmError

class SchemaMismatchError < SchemaError:
  attr diff

  def init(@message, @diff)

class UnknownAttributeError < OrmError:
  attr attribute

  def init(@attribute):
    @message = "unknown attribute: " + attribute.to_str

class ValidationError < OrmError:
  attr errors

  def init(@errors):
    @message = "validation failed"

class PersistenceError < OrmError

class NotFoundError < PersistenceError

class ExecutionEvent:
  attr id
  attr query
  attr started_at
  attr finished_at
  attr status
  attr result
  attr error

  def init(@id, @query):
    @started_at = Time.monotonic
    @finished_at = null
    @status = :running
    @result = null
    @error = null
  def running?():
    @status == :running
  def succeed!(result):
    @result = result
    @status = :success
    @finished_at = Time.monotonic
    self
  def fail!(error):
    @error = error
    @status = :error
    @finished_at = Time.monotonic
    self
  def elapsed_nanoseconds():
    finish = @finished_at or Time.monotonic
    (finish - @started_at).total_nanoseconds

class Instrumentation:
  attr subscribers

  def init(subscribers = []):
    @subscribers = subscribers.copy
    @sequence = Atomic.new(0)
  def subscribe!(subscriber):
    @subscribers.push!(subscriber)
    self
  def instrument(query, &execute):
    raise ArgumentError("instrument requires an execution block") unless execute
    id = @sequence.update: _1 + 1
    event = ExecutionEvent(id, query)
    @subscribers.each |subscriber|:
      subscriber.started(event)
    try:
      result = execute()
      event.succeed!(result)
      result
    rescue |error|:
      event.fail!(error)
      raise error
    ensure:
      @subscribers.reversed.each |subscriber|:
        subscriber.finished(event)

class QueryLogger:
  attr leave? from @leave
  attr dynamic? from @dynamic

  def init(@to: io.stderr(), @dynamic: false, @leave: true, @refresh: 0.08, @color: :auto):
    @mutex = Mutex.new()
    @entries = []
    @rendered_lines = 0
    @refresh_task = null
    @refreshing = false
    if @color == :auto:
      @color = @to.xterm?
    elif @color == :always:
      @color = true
    elif @color == :never:
      @color = false
    unless Bool === @color:
      raise ArgumentError("color must be Bool, :auto, :always, or :never")
    unless @refresh > 0:
      raise ArgumentError("refresh must be greater than zero")

  def started(event):
    return event unless @dynamic
    @mutex.synchronize:
      @entries.push!(event)
      _render_locked!()
      unless @refreshing:
        @refreshing = true
        @refresh_task = task.spawn:
          self._refresh_loop()
    event

  def finished(event):
    unless @dynamic:
      @mutex.synchronize:
        @to.write_line(_line(event))
        @to.flush()
      return event
    @mutex.synchronize:
      _render_locked!()
      active = @entries.any? |entry|: entry.running?
      unless active:
        if @leave:
          @rendered_lines = 0
        else:
          _clear_locked!()
        @entries = []
        @refreshing = false
        if @refresh_task:
          @refresh_task.cancel()
          @refresh_task = null
    event

  def _refresh_loop():
    try:
      while true:
        task.sleep(@refresh)
        keep_running = @mutex.synchronize:
          if @refreshing:
            _render_locked!()
            true
          else:
            false
        unless keep_running:
          break
    rescue CancelledError:
      null
    null

  def _render_locked!():
    if @rendered_lines > 0:
      @to.write_str("\u{1b}[#{@rendered_lines}A")
    @entries.each |event|:
      @to.write_str("\r\u{1b}[2K" + _line(event) + "\n")
    @to.flush()
    @rendered_lines = @entries.count
    null

  def _clear_locked!():
    return null if @rendered_lines == 0
    @to.write_str("\u{1b}[#{@rendered_lines}A")
    remaining = @rendered_lines
    while remaining > 0:
      @to.write_str("\r\u{1b}[2K\n")
      remaining -= 1
    @to.write_str("\u{1b}[#{@rendered_lines}A")
    @to.flush()
    @rendered_lines = 0
    null

  def _line(event):
    status = "..."
    status_color = 36
    if event.status == :success:
      status = "v"
      status_color = 32
    elif event.status == :error:
      status = "x"
      status_color = 31
    sql = event.query.sql.strip
    kind = _query_kind(sql)
    line = "[" + _paint(status_color, status) + "] " + _paint(_query_color(kind), kind) + " (" + _elapsed(event) + ") " + sql
    if event.query.params.present?:
      line = line + "  " + Amber.stringify(event.query.params, mode: :inspect)
    line

  def _elapsed(event):
    nanoseconds = event.elapsed_nanoseconds
    milliseconds = nanoseconds // 1000000
    tenth = (nanoseconds % 1000000) // 100000
    milliseconds.to_str + "." + tenth.to_str + "ms"

  def _query_kind(sql):
    words = sql.split(" ")
    return "SQL" if words.count == 0
    words[0].upcase

  def _query_color(kind):
    return 36 if kind == "SELECT" or kind == "PRAGMA" or kind == "WITH"
    return 32 if kind == "INSERT"
    return 33 if kind == "UPDATE"
    return 31 if kind == "DELETE"
    return 35 if kind == "BEGIN" or kind == "COMMIT" or kind == "ROLLBACK" or kind == "SAVEPOINT" or kind == "RELEASE"
    37

  def _paint(code, text):
    return text unless @color
    "\u{1b}[#{code}m" + text + "\u{1b}[0m"

class AttributeSpec:
  attr name
  attr type
  attr nullable? from @nullable
  attr default

  def init(@name, @type: :any, @nullable: true, @default: null)
  def column?():
    false

class Column < AttributeSpec:
  attr primary_key? from @primary_key
  attr generated? from @generated
  attr db_type

  def init(@name, @type: :any, @nullable: true, @default: null, @primary_key: false, @generated: false, @db_type: null)
  def column?():
    true

class ValidationSet:
  attr validations

  def init(@validations)

class AttributeSchema:
  attr attributes

  def init(@attributes)

class Schema:
  attr columns

  def init(@columns):
    @column_map = {}
    @columns.each |column|:
      @column_map[column.name] = column
  def names():
    @columns.map: _1.name
  def find(name):
    @column_map[?name]
  def primary_key():
    @columns.find |column|: column.primary_key?

class ExpectedSchema < Schema

class SchemaDiff:
  attr missing
  attr extra
  attr different

  def init(@missing, @extra, @different)
  def empty?():
    @missing.count == 0 and @extra.count == 0 and @different.count == 0
  def to_map():
    {missing: @missing, extra: @extra, different: @different}

class ModelConfig:
  attr name
  attr table
  attr expected_schema
  attr attributes
  attr validations
  attr executor
  attr tableless? from @tableless
  attr tableless_persisted? from @tableless_persisted

  def init(@name, @table: null, @expected_schema: null, @attributes: [], @validations: [], @executor: null, @tableless: false, @tableless_persisted: true):
    if @expected_schema:
      @attributes = @expected_schema.columns
    _reindex_attributes!()
  def expected_schema?():
    @expected_schema.present?
  def set_attributes!(attributes):
    @attributes = attributes
    _reindex_attributes!()
    self
  def _reindex_attributes!():
    @attribute_map = {}
    @attributes.each |spec|:
      @attribute_map[spec.name] = spec
  def columns():
    @attributes.select |spec|: spec.column?
  def set_executor!(executor):
    @executor = executor
    self
  def schema():
    Schema(columns)
  def primary_key():
    schema.primary_key
  def attribute(name):
    @attribute_map[?name]
  def has_attribute?(name):
    @attribute_map[?name].present?

class ModelType:
  attr config

  def init(@config):
    @record_factory = null
  def name():
    @config.name
  def table():
    @config.table
  def columns():
    @config.columns
  def attributes():
    @config.attributes
  def validations():
    @config.validations
  def bind!(executor):
    result = executor.bind(self)
    return result if result.err?
    @config.set_executor!(executor)
    Ok(self)
  def bound?():
    @config.executor.present?
  def set_record_factory!(&factory):
    @record_factory = factory
    self
  def new(attrs = {}, **kwargs):
    values = attrs.merge(kwargs)
    return @record_factory(values) if @record_factory
    Record(self, values)
  def call(attrs = {}, **kwargs):
    new(attrs, **kwargs)
  def create(attrs = {}, **kwargs):
    new(attrs, **kwargs).save
  def create_without_validation(attrs = {}, **kwargs):
    new(attrs, **kwargs).save_without_validation
  def find(id):
    executor = _require_executor(@config)
    return executor if executor.err?
    executor.value.find(self, id)
  def get(where:):
    executor = _require_executor(@config)
    return executor if executor.err?
    executor.value.get(self, where: where)
  def where(predicate = null, &blk):
    Query(self).where(predicate, &blk)

mixin ModelInstance:
  attr model
  attr errors
  attr persisted? from @persisted

  def _init_orm_instance!(model, attrs = {}):
    @model = model
    @attributes = {}
    @original = {}
    @persisted = false
    @errors = ValidationErrors()
    attrs.each |name, value|:
      _ensure_known!(name)
    @model.config.attributes.each |spec|:
      value = spec.default
      value = attrs[spec.name] if attrs.has_key?(spec.name)
      @attributes[spec.name] = value
      @original[spec.name] = value
    self

  def config():
    @model.config
  def new_record?():
    not @persisted
  def [](name):
    spec = _attribute!(name)
    @attributes[?spec.name]
  def []=(name, value):
    spec = _attribute!(name)
    @attributes[spec.name] = value
    value
  def assign!(attrs):
    attrs.each |name, value|:
      self[name] = value
    self
  def attributes():
    @attributes.copy
  def original_attributes():
    @original.copy
  def changes():
    out = {}
    @attributes.each |name, value|:
      before = @original[name]
      if before != value:
        out[name] = {before: before, after: value}
    out
  def changed?():
    changes.count > 0
  def changed_attributes():
    changes.keys
  def clear_changes!():
    @original = @attributes.copy
    self
  def mark_persisted!():
    @persisted = true
    clear_changes!()
    self
  def mark_new!():
    @persisted = false
    self
  def validate():
    validation_errors = ValidationErrors()
    @model.config.validations.each |spec|:
      spec.run(self, validation_errors)
    @errors = validation_errors
    if validation_errors.empty?:
      Ok(self)
    else:
      Err(ValidationError(validation_errors))
  def valid?():
    validate.ok?
  def save():
    _save(validate: true)
  def save_without_validation():
    _save(validate: false)
  def _save(validate:):
    if validate:
      validation = self.validate
      return validation if validation.err?
    executor = _require_executor(@model.config)
    return executor if executor.err?
    executor.value.save(self)
  def delete():
    executor = _require_executor(@model.config)
    return executor if executor.err?
    executor.value.delete(self)

  def _ensure_known!(name):
    _attribute!(name)
    true
  def _attribute!(name):
    spec = @model.config.attribute(name)
    unless spec:
      raise UnknownAttributeError(name)
    spec

class Record:
  include ModelInstance

  def init(model, attrs = {}):
    self._init_orm_instance!(model, attrs)

class WherePredicate:
  def and_where(other):
    _ensure_where_predicate!(other)
    WhereJunction(:all, self, other)
  def or_where(other):
    _ensure_where_predicate!(other)
    WhereJunction(:any, self, other)

class WhereComparison < WherePredicate:
  attr attribute
  attr operator
  attr value

  def init(@attribute, @operator, @value)

class WhereJunction < WherePredicate:
  attr operator
  attr left
  attr right

  def init(@operator, @left, @right)

class WhereMap < WherePredicate:
  attr values

  def init(values):
    @values = values.copy

class WhereField:
  attr name

  def init(@name)
  def ==(value):
    WhereComparison(@name, :eq, value)
  def !=(value):
    WhereComparison(@name, :ne, value)
  def >(value):
    WhereComparison(@name, :gt, value)
  def >=(value):
    WhereComparison(@name, :gte, value)
  def <(value):
    WhereComparison(@name, :lt, value)
  def <=(value):
    WhereComparison(@name, :lte, value)
  def one_of(values):
    WhereComparison(@name, :one_of, values)
  def not_one_of(values):
    WhereComparison(@name, :not_one_of, values)
  def present?():
    WhereComparison(@name, :ne, null)
  def absent?():
    WhereComparison(@name, :eq, null)

class WhereScope:
  def init(@model)
  def field(attribute):
    _ensure_query_attribute!(@model, attribute)
    WhereField(attribute)

class Query:
  attr model
  attr predicate

  def init(@model, @predicate: null)
  def where(predicate = null, &blk):
    if predicate and blk:
      raise ArgumentError("where accepts a predicate or a block, not both")
    next_predicate = predicate
    if blk:
      next_predicate = blk(WhereScope(@model))
      unless next_predicate:
        raise ArgumentError("where block must return a predicate")
    return self unless next_predicate
    normalized = _normalize_where(@model, next_predicate)
    if @predicate:
      normalized = WhereJunction(:all, @predicate, normalized)
    Query(@model, predicate: normalized)
  def all():
    executor = _require_executor(@model.config)
    return executor if executor.err?
    executor.value.all(@model, where: @predicate)
  def first():
    executor = _require_executor(@model.config)
    return executor if executor.err?
    executor.value.first(@model, where: @predicate)

class ValidationIssue:
  attr attribute
  attr code
  attr message
  attr source
  attr value
  attr meta

  def init(@attribute, @code, @message, @source: null, @value: null, @meta: {})
  def to_map():
    {attribute: @attribute, code: @code, message: @message, source: @source, value: @value, meta: @meta}

class ValidationErrors:
  attr issues

  def init():
    @issues = []
    @by_attribute = {}
  def add!(attribute, code:, message:, source: null, value: null, meta: {}):
    issue = ValidationIssue(attribute, code, message, source: source, value: value, meta: meta)
    @issues.push!(issue)
    @by_attribute.get_or_set!(attribute, []).push!(issue)
    self
  def empty?():
    @issues.count == 0
  def count():
    @issues.count
  def on(attribute):
    @by_attribute[?attribute] or []
  def to_map():
    grouped = {}
    @issues.each |issue|:
      grouped.get_or_set!(issue.attribute, []).push!(issue)
    grouped

class ValidationSpec:
  attr attribute
  attr code
  attr message
  attr source

  def init(@attribute, @code, @message, @predicate = null, @source: null, @meta: {}, &blk):
    if blk:
      @predicate = blk
  def run(record, errors):
    unless @predicate(record):
      errors.add!(@attribute,
        code: @code,
        message: @message,
        source: @source,
        value: record[@attribute],
        meta: @meta)
    errors

class TablelessExecutor:
  def init(persisted: true):
    @persisted = persisted
  def bind(model):
    Ok(model)
  def save(record):
    if @persisted:
      record.mark_persisted!()
    else:
      record.clear_changes!()
    Ok(record)
  def delete(record):
    record.mark_new!()
    record.clear_changes!()
    Ok(record)
  def find(model, id):
    Err(NotFoundError("tableless models do not support find"))
  def get(model, where:):
    Err(NotFoundError("tableless models do not support get"))
  def all(model, where: null):
    Err(PersistenceError("tableless models do not support query execution"))
  def first(model, where: null):
    Err(PersistenceError("tableless models do not support query execution"))

def __model(name: null, table: null, declarations: [], expected_schema: null, validations: []):
  model_name = name
  unless model_name:
    model_name = table
  schema = expected_schema
  rules = validations
  rules_declared = rules.count > 0
  declarations.each |declaration|:
    case declaration:
      when ExpectedSchema:
        if schema:
          raise OrmError("model declares expect_schema more than once")
        schema = declaration
      when ValidationSet:
        if rules_declared:
          raise OrmError("model declares validate more than once")
        rules = declaration.validations
        rules_declared = true
      when Column:
        raise OrmError("column is only valid inside expect_schema")
      else:
        raise OrmError("unsupported model declaration")
  ModelType(ModelConfig(model_name,
    table: table,
    expected_schema: schema,
    validations: rules))

def model(name: null, table: null, expected_schema: null, validations: []):
  __model(name: name, table:, expected_schema:, validations:)

def __tableless(name: null, declarations: [], schema: null, validations: [], persisted: true):
  attribute_schema = schema
  rules = validations
  rules_declared = rules.count > 0
  declarations.each |declaration|:
    case declaration:
      when AttributeSchema:
        if attribute_schema:
          raise OrmError("tableless model declares schema more than once")
        attribute_schema = declaration
      when Column:
        raise OrmError("column is only valid inside expect_schema")
      when AttributeSpec:
        raise OrmError("attribute is only valid inside schema")
      when ValidationSet:
        if rules_declared:
          raise OrmError("tableless model declares validate more than once")
        rules = declaration.validations
        rules_declared = true
      else:
        raise OrmError("unsupported tableless declaration")
  specs = []
  if attribute_schema:
    unless AttributeSchema === attribute_schema:
      raise OrmError("tableless schema must be an AttributeSchema")
    attribute_schema.attributes.each |spec|:
      unless AttributeSpec === spec and not spec.column?:
        raise OrmError("tableless schema accepts attribute declarations only")
      specs.push!(spec)
  cfg = ModelConfig(name,
    attributes: specs,
    validations: rules,
    executor: TablelessExecutor(persisted: persisted),
    tableless: true,
    tableless_persisted: persisted)
  ModelType(cfg)

def tableless(name: null, schema: null, validations: [], persisted: true):
  __tableless(name: name, schema:, validations:, persisted:)

def column(name, type: :any, nullable: true, default: null, primary_key: false, generated: false, db_type: null):
  Column(name, type:, nullable:, default:, primary_key:, generated:, db_type:)

def attribute(name, type: :any, nullable: true, default: null):
  AttributeSpec(name, type:, nullable:, default:)

def check(attribute, code: :invalid, message: null, source: null, meta: {}, &predicate):
  msg = message
  unless msg:
    msg = "must satisfy " + (source or attribute.to_str)
  ValidationSpec(attribute, code, msg, predicate, source: source, meta: meta)

def _require_executor(config):
  executor = config.executor
  if executor:
    Ok(executor)
  else:
    Err(PersistenceError("model is not bound to an executor"))

def _ensure_where_predicate!(predicate):
  unless WherePredicate === predicate:
    raise ArgumentError("where expression must be a predicate")
  predicate

def _ensure_query_attribute!(model, attribute):
  unless model.config.has_attribute?(attribute):
    raise UnknownAttributeError(attribute)
  attribute

def _normalize_where(model, predicate):
  normalized = case predicate:
    when (Map | StrictMap):
      WhereMap(predicate)
    when WherePredicate:
      predicate
    else:
      raise ArgumentError("where expects a Map or a predicate")
  _validate_where_attributes!(model, normalized)
  normalized

def _validate_where_attributes!(model, predicate):
  case predicate:
    when WhereComparison:
      _ensure_query_attribute!(model, predicate.attribute)
    when WhereJunction:
      _validate_where_attributes!(model, predicate.left)
      _validate_where_attributes!(model, predicate.right)
    when WhereMap:
      predicate.values.each |attribute, value|:
        _ensure_query_attribute!(model, attribute)
    else:
      raise ArgumentError("unsupported where predicate")
  predicate

macro def attribute(name as Ast, type as Ast: null, nullable as Ast: null, default as Ast: null) -> Ast:
  unless type:
    type = quote:
      :any
  unless nullable:
    nullable = quote:
      true
  unless default:
    default = quote:
      null
  return quote:
    orm.AttributeSpec(#{name}, type: #{type}, nullable: #{nullable}, default: #{default})

macro def schema(&blk) -> Ast:
  attributes = blk().expressions
  return quote:
    orm.AttributeSchema([#{*attributes}])

macro def column(name as Ast, type as Ast: null, nullable as Ast: null, default as Ast: null, primary_key as Ast: null, generated as Ast: null, db_type as Ast: null) -> Ast:
  unless type:
    type = quote:
      :any
  unless nullable:
    nullable = quote:
      true
  unless default:
    default = quote:
      null
  unless primary_key:
    primary_key = quote:
      false
  unless generated:
    generated = quote:
      false
  unless db_type:
    db_type = quote:
      null
  return quote:
    orm.Column(#{name}, type: #{type}, nullable: #{nullable}, default: #{default}, primary_key: #{primary_key}, generated: #{generated}, db_type: #{db_type})

macro def expect_schema(&blk) -> Ast:
  columns = blk().expressions
  return quote:
    orm.ExpectedSchema([#{*columns}])

macro def validate(&blk) -> Ast:
  validations = blk().expressions
  return quote:
    orm.ValidationSet([#{*validations}])

macro def expect(attribute as Ast, expr as Ast, code as Ast: null, message as Ast: null) -> Ast:
  unless attribute.kind == "AstLiteral" and attribute.token == "SYMBOL":
    raise ArgumentError("orm.expect attribute must be a symbol literal")
  code_node = code
  unless code_node:
    code_node = quote:
      :invalid
  msg = message
  unless msg:
    msg = Ast.lift("must satisfy " + expr.source)
  getter = quote:
    record[#{attribute}]
  predicate = expr.replace_name(attribute.value, getter)
  return quote:
    orm.ValidationSpec(#{attribute}, #{code_node}, #{msg}, source: #{Ast.lift(expr.source)}) |record|:
      #{predicate}

# `use` supplies the enclosing class AST as `subject`; a direct call may use
# the same slot for its optional positional model name.
macro def _model_members(subject as Ast, descriptor as Ast) -> Ast:
  class_node = Ast.node("AstName", {name: subject.name})
  return quote:
    include orm.ModelInstance

    def init(attrs = {}, **kwargs):
      self._init_orm_instance!(#{class_node}.orm_model, attrs.merge(kwargs))

    class_method def orm_model():
      if @@orm_model:
        @@orm_model
      else:
        @@orm_model = #{descriptor}
        @@orm_model.set_record_factory! |attrs|:
          #{class_node}(attrs)
        @@orm_model

    class_method def model():
      orm_model

    class_method def bind!(executor):
      orm_model.bind!(executor)

    class_method def new(attrs = {}, **kwargs):
      orm_model.new(attrs, **kwargs)

    class_method def create(attrs = {}, **kwargs):
      orm_model.create(attrs, **kwargs)

    class_method def create_without_validation(attrs = {}, **kwargs):
      orm_model.create_without_validation(attrs, **kwargs)

    class_method def find(id):
      orm_model.find(id)

    class_method def get(where:):
      orm_model.get(where: where)

    class_method def where(predicate = null, &blk):
      orm_model.where(predicate, &blk)

macro def model(subject as Ast = null, name as Ast: null, table as Ast: null, expected_schema as Ast: null, validations as Ast: null, &blk) -> Ast:
  if subject and subject.kind == "AstClassDef":
    if name:
      raise ArgumentError("orm.model use form derives name from the class")
    table_node = table
    unless table_node:
      table_node = Ast.lift(subject.name.underscored + "s")
    schema_node = expected_schema
    unless schema_node:
      schema_node = quote:
        null
    validations_node = validations
    unless validations_node:
      validations_node = quote:
        []
    declarations = []
    if blk:
      declarations = blk().expressions
    descriptor = quote:
      orm.__model(name: #{Ast.lift(subject.name)}, table: #{table_node}, declarations: [#{*declarations}], expected_schema: #{schema_node}, validations: #{validations_node})
    return _model_members(subject, descriptor)

  if blk:
    raise ArgumentError("orm.model factory form does not accept a block")
  if subject and name:
    raise ArgumentError("orm.model name must be positional or keyword, not both")
  name_node = name or subject
  unless name_node:
    name_node = quote:
      null
  table_node = table
  unless table_node:
    table_node = quote:
      null
  schema_node = expected_schema
  unless schema_node:
    schema_node = quote:
      null
  validations_node = validations
  unless validations_node:
    validations_node = quote:
      []
  return quote:
    orm.__model(name: #{name_node}, table: #{table_node}, expected_schema: #{schema_node}, validations: #{validations_node})

