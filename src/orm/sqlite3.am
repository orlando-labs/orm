package orm.sqlite3

import sqlite3
from orm.sqlite3.adapter import adapter as adapter_impl
from orm.sqlite3.pool import wrap as wrap_pool

export adapter, pool, memory_pool

def adapter(db, instrumentation: null):
  adapter_impl(db, instrumentation: instrumentation)

def pool(
  path as (Str | fs.Path),
  mode as Symbol: :create,
  uri as Bool: false,
  min_size as Int: 0,
  max_size as Int: 5,
  checkout_timeout as (Float | Int | TimePeriod)?: 5.0,
  idle_timeout as (Float | Int | TimePeriod)?: 60.0,
  max_lifetime as (Float | Int | TimePeriod)?: null,
  busy_timeout as (Float | Int | TimePeriod)?: null,
  pragmas as (Map | StrictMap): {},
  instrumentation: null,
  &blk
):
  native_pool = sqlite3.pool(path,
    mode: mode,
    uri: uri,
    min_size: min_size,
    max_size: max_size,
    checkout_timeout: checkout_timeout,
    idle_timeout: idle_timeout,
    max_lifetime: max_lifetime,
    busy_timeout: busy_timeout,
    pragmas: pragmas)
  database = _database(native_pool, instrumentation)
  return database unless blk
  try:
    blk(database)
  ensure:
    database.close!

def memory_pool(
  name as (Str | Symbol): "amber_orm_pool",
  min_size as Int: 1,
  max_size as Int: 5,
  checkout_timeout as (Float | Int | TimePeriod)?: 5.0,
  idle_timeout as (Float | Int | TimePeriod)?: 60.0,
  max_lifetime as (Float | Int | TimePeriod)?: null,
  busy_timeout as (Float | Int | TimePeriod)?: null,
  pragmas as (Map | StrictMap): {},
  instrumentation: null,
  &blk
):
  native_pool = sqlite3.memory_pool(
    name: name,
    min_size: min_size,
    max_size: max_size,
    checkout_timeout: checkout_timeout,
    idle_timeout: idle_timeout,
    max_lifetime: max_lifetime,
    busy_timeout: busy_timeout,
    pragmas: pragmas)
  database = _database(native_pool, instrumentation)
  return database unless blk
  try:
    blk(database)
  ensure:
    database.close!

def _database(native_pool, instrumentation):
  if instrumentation:
    native_pool.instrument_queries!(instrumentation)
  wrap_pool(native_pool)
